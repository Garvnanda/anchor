    "/v1/chat/completions": {
      "post": {
        "summary": "Managed primary generation",
        "description": "OpenAI-compatible transport. B1 verifies the exact stream and tool dialect against the pinned OpenCode CLI.",
        "servers": [{ "url": "http://127.0.0.1:8766" }],
        "security": [{ "localBearer": [] }],
        "parameters": [
          { "name": "X-Anchor-Inference-Request-Id", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 128 } },
          { "name": "X-Anchor-Run-Id", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 128 } },
          { "name": "X-Anchor-Session-Id", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 128 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": { "type": "string", "minLength": 1 },
                  "messages": { "type": "array", "minItems": 1, "items": { "type": "object" } },
                  "stream": { "type": "boolean" },
                  "tools": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion or streamed completion chunks.",
            "content": {
              "application/json": { "schema": { "type": "object" } },
              "text/event-stream": { "schema": { "type": "string" } }
            }
          },
          "400": { "description": "Invalid or unsupported generation input." },
          "401": { "description": "Missing or invalid local bearer." },
          "403": { "description": "Disallowed Host or Origin." },
          "409": { "description": "Duplicate inference request ID." },
          "503": { "description": "Managed generation unavailable." }
        }
      }
    },
